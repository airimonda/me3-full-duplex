(version 1)
; ME3 task sandbox: the agent (pi.dev or Hermes) may do anything EXCEPT
; write outside the sandbox, its own runtime dirs and system temp dirs.
; sandbox-exec does NOT expand "~": tasks.py passes -D HOME=<abs home>
; (the old "~/sandbox" rules never matched, so every write was denied).
(allow default)
(deny file-write*)
(allow file-write*
  (subpath (string-append (param "HOME") "/sandbox"))
  (subpath (string-append (param "HOME") "/.hermes"))
  (subpath (string-append (param "HOME") "/.pi"))
  (subpath (string-append (param "HOME") "/Library/Caches"))
  (subpath "/private/tmp")
  (subpath "/tmp")
  (subpath "/dev")
  (regex #"^/private/var/folders")
  (regex #"^/var/folders"))
(allow file-read-data (subpath "/dev"))
(allow process-exec (subpath "/dev"))
